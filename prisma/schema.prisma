// Choice Office Furniture — data model
//
// Two rules run through the whole schema:
//   1. Money is always Decimal(12,2). Never Float, and never arithmetic in JS
//      numbers — see lib/money.ts.
//   2. Orders keep snapshots. An order line stores the product's name, SKU and
//      price as they were at purchase, so editing or deleting a product later
//      cannot rewrite history.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 removed `url` and `directUrl` from the schema. The CLI's connection
// now lives in prisma.config.ts (pointed at DIRECT_URL, since migrations cannot
// run through the transaction pooler), and the runtime connection is supplied
// by the driver adapter in lib/prisma.ts (pointed at the pooled DATABASE_URL).
datasource db {
  provider = "postgresql"
}

// ───────────────────────────── enums ─────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// SIMPLE products have exactly one (default) variant; VARIABLE products have
/// one per combination of their attribute values. Either way the variant is
/// what carries price, stock, SKU and images — so the cart, orders and the
/// ledger never branch on product type.
enum ProductType {
  SIMPLE
  VARIABLE
}

enum AttributeDisplay {
  BUTTONS
  SWATCHES
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PROCESSING
  READY_FOR_DISPATCH
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InventoryReason {
  INITIAL_STOCK
  ORDER_CONFIRMED // negative: an order moved to CONFIRMED
  ORDER_CANCELLED // positive: a confirmed order was cancelled
  MANUAL_ADJUSTMENT
  STOCK_RECEIVED
  DAMAGE_WRITE_OFF
  STOCKTAKE_CORRECTION
}

// ───────────────────────────── auth ─────────────────────────────

model AdminUser {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  isActive     Boolean @default(true)

  /// Incremented on password change or "sign out everywhere". The session JWT
  /// carries a copy, and requireAdmin() compares them — which is how a
  /// stateless token can still be revoked immediately.
  sessionEpoch Int       @default(0)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusChanges  OrderStatusHistory[]
  inventoryMoves InventoryTransaction[]

  @@map("admin_users")
}

// ─────────────────────────── catalog ───────────────────────────

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  /// Backdrop behind the tile photo — the inline `--tone` from the original.
  toneHex   String? @db.VarChar(9)
  imagePath String?

  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)
  /// Flat categories plus this flag satisfy "control category display on the
  /// homepage" without needing a parent/child relation.
  showOnHomepage  Boolean @default(false)
  homepageBlurb   String?

  metaTitle       String?
  metaDescription String? @db.VarChar(320)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  specTemplates CategorySpecTemplate[]

  @@index([isActive, sortOrder])
  @@index([showOnHomepage, sortOrder])
  @@map("categories")
}

model Product {
  id               String  @id @default(cuid())
  slug             String  @unique
  /// Base code for the product. Each variant carries its own unique SKU; for a
  /// simple product the default variant simply reuses this one.
  sku              String  @unique
  name             String
  shortDescription String? @db.VarChar(320)
  description      String?

  type ProductType @default(SIMPLE)

  /// Cheapest active variant price. A denormalised sort/display key, kept in
  /// step by syncProductSummary() in lib/services/variants.ts — the variants
  /// are the source of truth, this exists so the shop can ORDER BY price.
  minPrice Decimal @default(0) @db.Decimal(12, 2)
  currency String  @default("PKR") @db.VarChar(3)

  status       ProductStatus @default(DRAFT)
  isFeatured   Boolean       @default(false)
  isBestseller Boolean       @default(false)
  /// A manual badge. The "-20%" and "Low stock" badges are computed.
  badge        String?       @db.VarChar(32)
  sortOrder    Int           @default(0)

  /// Presentation knobs carried over from the hand-tuned cards. They are
  /// columns, not CSS, so the admin keeps per-product control of them.
  toneHex             String? @db.VarChar(9)
  imageObjectPosition String? @db.VarChar(24)
  imageLift           Boolean @default(false)

  metaTitle       String?
  metaDescription String? @db.VarChar(320)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  attributes     ProductAttribute[]
  variants       ProductVariant[]
  images         ProductImage[]
  specifications ProductSpecification[]
  orderItems     OrderItem[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Equality columns first so Postgres can satisfy the ORDER BY from the index.
  @@index([status, categoryId, minPrice])
  @@index([status, minPrice])
  @@index([status, isFeatured, sortOrder])
  @@index([status, isBestseller, sortOrder])
  @@index([status, createdAt])
  @@map("products")
}

/// An option dimension of one product: Colour, Material, Size, Configuration…
/// Per product rather than global, so an admin can invent "Armrest type" for
/// one chair without it appearing on every desk.
model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name      String           @db.VarChar(60)
  display   AttributeDisplay @default(BUTTONS)
  sortOrder Int              @default(0)

  values  ProductAttributeValue[]
  options VariantOption[]

  @@unique([productId, name])
  @@index([productId, sortOrder])
  @@map("product_attributes")
}

model ProductAttributeValue {
  id          String           @id @default(cuid())
  attributeId String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  value     String  @db.VarChar(80)
  /// Colour chip shown when the attribute displays as swatches.
  swatchHex String? @db.VarChar(9)
  sortOrder Int     @default(0)

  options VariantOption[]

  @@unique([attributeId, value])
  @@index([attributeId, sortOrder])
  @@map("product_attribute_values")
}

/// The sellable unit. Price, stock, SKU and images all live here.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String   @unique @db.VarChar(64)
  price          Decimal  @db.Decimal(12, 2)
  /// Regular price shown struck through. The discount % and the sale badge are
  /// derived from this and `price`, never stored.
  compareAtPrice Decimal? @db.Decimal(12, 2)

  stockQuantity     Int     @default(0)
  lowStockThreshold Int     @default(3)
  trackInventory    Boolean @default(true)

  /// Inactive variants are hidden from the shop but kept for order history.
  isActive  Boolean @default(true)
  /// Preselected on the product page; the only variant of a simple product.
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  options        VariantOption[]
  images         ProductImage[]
  specifications ProductSpecification[]
  orderItems     OrderItem[]
  inventory      InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive, sortOrder])
  @@map("product_variants")
}

/// One chosen value per attribute, per variant. Restrict on the attribute and
/// value, so an option a variant still depends on cannot be deleted out from
/// under it and leave that variant with a silent gap in its description.
///
/// Consequence worth knowing: deleting a whole product must remove its variants
/// FIRST. Cascades run as separate statements, so the attribute cascade can
/// fire before the variants' option rows are gone and trip this constraint.
/// deleteProduct() in lib/actions/products.ts does it in that order.
model VariantOption {
  variantId   String
  variant     ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   ProductAttribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  valueId     String
  value       ProductAttributeValue @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeId])
  @@index([valueId])
  @@map("variant_options")
}

/// A label/value pair. variantId null = applies to the whole product; set =
/// applies to that variant and overrides a product spec of the same name.
model ProductSpecification {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  groupName String? @db.VarChar(60)
  name      String  @db.VarChar(80)
  value     String  @db.VarChar(400)
  sortOrder Int     @default(0)

  @@index([productId, variantId, sortOrder])
  @@map("product_specifications")
}

/// The spec names a category usually needs ("Seat height", "Max load"…),
/// offered as a starting point in the product form. Chairs, desks and
/// accessories each describe themselves differently.
model CategorySpecTemplate {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  groupName String? @db.VarChar(60)
  name      String  @db.VarChar(80)
  sortOrder Int     @default(0)

  @@unique([categoryId, name])
  @@index([categoryId, sortOrder])
  @@map("category_spec_templates")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// null = shared product gallery; set = belongs to that variant, which then
  /// shows only its own images. `isPrimary` is unique per scope.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// The storage KEY, never a full URL — that is what makes the storage driver
  /// swappable without a data migration.
  storagePath    String
  altText        String
  width          Int?
  height         Int?
  bytes          Int?
  mimeType       String  @db.VarChar(64)
  objectPosition String? @db.VarChar(24)
  sortOrder      Int     @default(0)
  isPrimary      Boolean @default(false)

  createdAt DateTime @default(now())

  /// No uniqueness on the path: two variants of one product may legitimately
  /// share a photo (every width of the walnut desk shows the same walnut shot).
  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
  @@map("product_images")
}

// ────────────────────── customers and orders ──────────────────────

model Customer {
  /// E.164, the dedupe key and the WhatsApp dial string: "+923001234567".
  phoneE164 String  @unique @db.VarChar(20)
  /// Exactly what the customer typed, which the shop owner recognises.
  phoneRaw  String  @db.VarChar(32)
  id        String  @id @default(cuid())
  name      String
  email     String?
  notes     String?

  addressLine String?
  city        String?
  province    String?
  postalCode  String? @db.VarChar(16)

  orderCount  Int       @default(0)
  lastOrderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([email])
  @@index([createdAt])
  @@map("customers")
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique @db.VarChar(20)

  /// Minted by the cart and submitted with the form, so a double-click, a
  /// retried POST and a second tab all carry the same key and return the
  /// original order instead of creating another.
  idempotencyKey String? @unique @db.VarChar(64)

  status OrderStatus @default(PENDING_CONFIRMATION)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Contact and address snapshot — survives the customer record being edited
  /// or erased, which is why these duplicate Customer.
  customerName       String
  customerPhone      String  @db.VarChar(32)
  customerPhoneE164  String  @db.VarChar(20)
  customerEmail      String?
  shippingAddress    String
  shippingCity       String
  shippingProvince   String?
  shippingPostalCode String? @db.VarChar(16)
  customerNote       String?

  currency    String  @default("PKR") @db.VarChar(3)
  subtotal    Decimal @db.Decimal(12, 2)
  shippingFee Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  itemCount   Int

  whatsappMessage  String?
  /// Stamped by a beacon when the customer actually opens WhatsApp. Orders
  /// where this stays null are leads to phone, not failures.
  whatsappOpenedAt DateTime?

  /// True once stock has been removed. The stock effect keys off this flag
  /// rather than being inferred from status, so an unusual transition cannot
  /// double-apply.
  stockCommitted Boolean @default(false)

  adminNote    String?
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     OrderItem[]
  history   OrderStatusHistory[]
  inventory InventoryTransaction[]

  @@index([status, createdAt])
  @@index([customerPhoneE164])
  @@index([createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Nullable + SetNull on purpose. Cascade would delete order history when a
  /// discontinued product is removed; Restrict would make products
  /// undeletable, pushing admins to edit an old product into a new one —
  /// exactly the mutation these snapshots exist to prevent.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // ---- immutable snapshot, written once ----
  productName  String
  /// The VARIANT's SKU — what the shop actually picks and ships.
  productSku   String  @db.VarChar(64)
  /// "Black / Leather" and the structured form of it, as ordered.
  variantLabel   String?
  variantOptions Json?
  productSlug  String
  categoryName String
  unitPrice    Decimal @db.Decimal(12, 2)
  /// Regular price at the time of the order, so the discount the customer saw
  /// is reconstructable even after the variant is repriced.
  compareAtPrice Decimal? @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(12, 2)
  imagePath    String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?

  changedById String?
  changedBy   AdminUser? @relation(fields: [changedById], references: [id], onDelete: SetNull)
  /// Snapshot of who acted, so deleting a staff account does not erase the
  /// audit trail. "customer" and "system" are also valid values.
  changedByLabel String @default("system")

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model InventoryTransaction {
  id        String @id @default(cuid())
  variantId String
  /// Restrict, deliberately asymmetric with OrderItem: the ledger has to
  /// reconcile against ProductVariant.stockQuantity, so a stocked variant is
  /// deactivated rather than hard-deleted.
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  /// Signed: negative removes stock, positive adds.
  quantityDelta Int
  reason        InventoryReason
  /// Balance after this entry, so stock is auditable without replaying the
  /// whole ledger.
  resultingQuantity Int
  note              String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// The database-level proof against double-decrement. If the row lock and
  /// the stockCommitted flag are ever both defeated by a code change, this
  /// throws instead of letting stock drift silently.
  @@unique([orderId, variantId, reason], name: "uniq_order_variant_reason")
  @@index([variantId, createdAt])
  @@index([reason, createdAt])
  @@map("inventory_transactions")
}

// ───────────────────────── config and content ─────────────────────────

/// Single row, not key/value: typed columns, one cached query, and NOT NULL on
/// the WhatsApp number the entire checkout depends on. A missing key in a KV
/// design is a runtime undefined discovered in production.
model WebsiteSetting {
  id String @id @default("singleton")

  brandName String  @default("Choice Office Furniture")
  tagline   String?
  logoPath  String?
  faviconPath String?

  /// Where orders are sent. Editable in admin — never hardcoded.
  whatsappE164    String @db.VarChar(20)
  whatsappDisplay String @db.VarChar(32)
  phone           String?
  email           String?
  addressLine     String?
  city            String?
  mapUrl          String?
  openingHours    String?

  currencyCode          String   @default("PKR") @db.VarChar(3)
  currencySymbol        String   @default("Rs.") @db.VarChar(8)
  shippingFee           Decimal  @default(0) @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  shippingNote          String?

  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  whatsappUrl  String?

  metaTitle       String?
  metaDescription String? @db.VarChar(320)
  ogImagePath     String?

  deliveryPolicy String?
  returnPolicy   String?
  privacyPolicy  String?
  termsPolicy    String?

  orderNumberPrefix  String  @default("ORD") @db.VarChar(8)
  lowStockAlertEmail String?
  maintenanceMode    Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("website_settings")
}

/// Per-year counter for human-readable order numbers (ORD-2026-0001).
/// Incremented with INSERT … ON CONFLICT DO UPDATE … RETURNING, which is
/// atomic under concurrency — unlike COUNT(*)+1, which races.
model OrderSequence {
  year      Int @id
  lastValue Int @default(0)

  @@map("order_sequences")
}

model HomepageSection {
  id        String  @id @default(cuid())
  key       String  @unique @db.VarChar(40)
  isVisible Boolean @default(true)
  sortOrder Int     @default(0)

  eyebrow    String?
  heading    String?
  subheading String?
  bodyText   String?
  ctaLabel   String?
  ctaHref    String?
  imagePath  String?

  /// Section-specific extras, validated by a Zod discriminated union on `key`.
  payload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, sortOrder])
  @@map("homepage_sections")
}

/// Fixed-window rate limiting without Redis. The key is a hash, so this table
/// is not a log of visitor IP addresses.
model RateLimitHit {
  id          String   @id @default(cuid())
  bucketKey   String   @db.VarChar(128)
  windowStart DateTime
  count       Int      @default(1)

  @@unique([bucketKey, windowStart])
  @@index([windowStart])
  @@map("rate_limit_hits")
}
