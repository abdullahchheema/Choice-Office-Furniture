# ============================================================
# Choice Office Furniture — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ============================================================

# ---------- Database (Supabase Postgres, via Prisma) ----------
# Pooled connection used by the app at runtime (PgBouncer, transaction mode).
# Find the password under Supabase -> Project Settings -> Database.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection, port 5432. REQUIRED and separate from the above:
# `prisma migrate` cannot run through the transaction pooler (no prepared
# statements, no CREATE INDEX CONCURRENTLY) and fails confusingly without this.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres"

# ---------- Supabase (Storage only; Postgres goes through Prisma) ----------
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<ANON_PUBLIC_KEY>"

# Server-only. Bypasses row-level security — treat as a root password.
# Must never gain a NEXT_PUBLIC_ prefix and never be imported client-side.
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"

SUPABASE_STORAGE_BUCKET="product-images"

# "supabase" in production, "local" to write to /public/uploads during dev
STORAGE_DRIVER="supabase"

# ---------- Admin authentication ----------
# Signing key for admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="<32_BYTE_RANDOM_STRING>"

# Used once by `npm run db:seed` to create the first admin account.
# The seed refuses to run in production if the password is under 12 characters.
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_PASSWORD="<CHOOSE_A_STRONG_PASSWORD>"

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
